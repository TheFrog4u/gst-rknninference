+class _PicoDetPaddleOutputWrapper(torch.nn.Module):
+    """Emit PaddleDetection's raw PicoDet score and DFL-regression tensors."""
+
+    def __init__(self, model: torch.nn.Module):
+        super().__init__()
+        self.model = model
+
+    def forward(self, x):
+        head = self.model.head
+        was_export = head.export
+        head.export = False
+        try:
+            cls_scores, bbox_preds = self.model(x)
+        finally:
+            head.export = was_export
+        scores = tuple(
+            torch.sigmoid(score).permute(0, 2, 3, 1).reshape(1, -1, score.shape[1])
+            for score in cls_scores
+        )
+        regressions = tuple(
+            prediction.permute(0, 2, 3, 1).reshape(1, -1, prediction.shape[1])
+            for prediction in bbox_preds
+        )
+        return (*scores, *regressions)
+
